# Defaults need no .env file: the profile picks the data directory and default port
# (table in README.md, "数据与配置"). In development the page, API and Vite HMR share PORT.
# Files load in this order, later winning, the shell above all of them:
# .env, .env.local, .env.<profile>, .env.<profile>.local
# HOST=127.0.0.1
# PORT=3500

# Explicit data directory override (takes precedence over profile)
# SCHOLARAIO_HUB_DATA_DIR=/absolute/path/to/data
# Named profile; `--production` / `--profile <name>` on any pnpm command sets it too.
# SCHOLARAIO_HUB_PROFILE=dev
# Optional executable override for uv used by setup, the semantic-search install and tests.
# SCHOLARAIO_HUB_UV=/path/to/uv

# CLI credentials and native transcripts remain in their normal CLI locations.
# The application does not enumerate those transcripts.
# ENABLED_PROVIDERS=claude,codex
# IDLE_TIMEOUT=300

# Logging: the console always; a file too in production (on by default there), kept in
# <data directory>/logs, rotated daily or at 10 MB with 7 old files kept, readable by you only.
# LOG_PRETTY defaults to readable lines in a terminal and JSON lines otherwise.
# LOG_LEVEL=info
# LOG_FILE_LEVEL=debug
# LOG_TO_FILE=true
# LOG_PRETTY=true
# LOG_DIR=/absolute/path/to/logs
# LOG_FILE=server.log

# Extra hostnames the API answers to besides localhost (comma-separated); "*" turns the
# host check off. The Hub has no login, so only name hosts you control.
# ALLOWED_HOSTS=hub.local
# CLIENT_DIST_DIR=/absolute/path/to/client/dist
# 科研 Skills 目录，默认 <数据目录>/skills（仅浏览，不扫描外部会话）
# SCHOLARAIO_SKILLS_DIR=/absolute/path/to/scholaraio/skills

# Which Claude Code to run (default: the SDK's native binary, then `claude` on PATH), and the
# macOS Keychain entry holding its login. Agents keep these too.
# CLAUDE_CODE_EXECUTABLE=/absolute/path/to/claude
# CLAUDE_CODE_KEYCHAIN_SERVICE=Claude Code-credentials

# Debug-only raw protocol logs, written to the log directory (off by default).
# LOG_SDK_MESSAGES=true          # sdk-raw.jsonl: every raw Claude SDK message and Codex notification
