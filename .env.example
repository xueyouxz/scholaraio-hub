# ── Server ──────────────────────────────────────────────────────────────────
PORT=3400
HOST=127.0.0.1
NODE_ENV=development

# Optional: override derived client/preview ports (defaults: PORT+1, PORT+2)
# CLIENT_PORT=3401
# CLIENT_PREVIEW_PORT=3402

# ── Data directory ──────────────────────────────────────────────────────────
# Profile name: data dir becomes ~/.scholaraio-hub-{profile}/
# In production, defaults to ~/.scholaraio-hub/
SCHOLARAIO_HUB_PROFILE=dev

# Explicit data directory override (takes precedence over profile)
# SCHOLARAIO_HUB_DATA_DIR=/custom/path

# ── Claude integration ───────────────────────────────────────────────────────
# Defaults are read from the claude CLI installation (~/.claude/)
# CLAUDE_CONFIG_DIR=~/.claude
# CLAUDE_SESSIONS_DIR=~/.claude/projects
# CLAUDE_PROJECTS_DIR=~/.claude/projects

# ── Codex integration ────────────────────────────────────────────────────────
# CODEX_SESSIONS_DIR=~/.codex
# Interval (ms) for periodic filesystem rescan; default: 30000
# CODEX_WATCH_PERIODIC_RESCAN_MS=30000

# ── Provider control ─────────────────────────────────────────────────────────
# Comma-separated list of enabled providers. Omit to enable all.
# ENABLED_PROVIDERS=claude,codex

# ── Permission mode ──────────────────────────────────────────────────────────
# one of: default | acceptEdits | plan | bypassPermissions
# PERMISSION_MODE=default

# ── Performance ───────────────────────────────────────────────────────────────
# Max concurrent session workers; default: number of CPU cores
# MAX_WORKERS=4
# Session idle timeout (ms) before worker is released; default: 300000
# IDLE_TIMEOUT=300000
# Max file upload size in MB; default: 10
# MAX_UPLOAD_SIZE_MB=10
# Max queued jobs before new ones are rejected; default: 100
# MAX_QUEUE_SIZE=100

# ── Logging ───────────────────────────────────────────────────────────────────
# one of: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# LOG_FILE_LEVEL=debug
# LOG_TO_FILE=false
LOG_PRETTY=true
# LOG_DIR=~/.scholaraio-hub/logs

# ── Network ───────────────────────────────────────────────────────────────────
# Enable self-signed HTTPS certificate for remote access
# HTTPS_SELF_SIGNED=false

# ── Scholar gateway (optional enhancement) ────────────────────────────────────
# Requires scholaraio CLI: https://github.com/ZimoLiao/scholaraio
# SCHOLARAIO_API_URL=http://localhost:7070

# Optional path to uv (default: uv on PATH). Used only by pnpm run setup.
# SCHOLARAIO_HUB_UV=/path/to/uv
# Development defaults to port 3500, production to 3400.
# Python is managed by Node and uses an internal dynamic loopback port.
