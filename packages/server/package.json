{
  "name": "@scholaraio-hub/server",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "bin": {
    "scholaraio-hub": "dist/cli.js"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --conditions source src/index.ts",
    "dev:watch": "tsx watch --conditions source src/index.ts",
    "dev:mock": "AUTH_DISABLED=true tsx --conditions source src/index.ts",
    "start": "NODE_ENV=production node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run test/e2e",
    "test:e2e:real": "REAL_SDK_TESTS=true vitest run test/e2e",
    "test:e2e:real:fg": "REAL_SDK_TESTS=true FOREGROUND=1 vitest run test/e2e"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.90",
    "@hono/node-server": "^1.19.9",
    "@hono/node-ws": "^1.2.0",
    "@scholaraio-hub/shared": "workspace:*",
    "diff": "^8.0.3",
    "dotenv": "^17.4.2",
    "hono": "^4.12.1",
    "marked": "^17.0.1",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "sanitize-html": "^2.17.1",
    "shiki": "^3.20.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/marked": "^6.0.0",
    "@types/node": "^22.10.2",
    "@types/sanitize-html": "^2.16.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
