# Defaults need no .env file. pnpm dev uses ~/.scholaraio-hub-dev and port 3500;
# pnpm start uses ~/.scholaraio-hub and port 3400. Client ports derive from PORT.
# HOST=127.0.0.1
# PORT=3500
# CLIENT_PORT=3501
# CLIENT_PREVIEW_PORT=3502

# Explicit data directory override (takes precedence over profile)
# SCHOLARAIO_HUB_DATA_DIR=/absolute/path/to/data
# Optional named profile for direct server commands; root scripts select dev/production.
# SCHOLARAIO_HUB_PROFILE=dev
# Optional executable override for uv used by setup/test tooling.
# SCHOLARAIO_HUB_UV=/path/to/uv

# CLI credentials and native transcripts remain in their normal CLI locations.
# The application does not enumerate those transcripts. Import selected JSONL in the UI.
# ENABLED_PROVIDERS=claude,codex
# IDLE_TIMEOUT=300
# PERMISSION_MODE=default

# Logging defaults to console; file logs go under the selected data directory.
# LOG_LEVEL=info
# LOG_FILE_LEVEL=debug
# LOG_TO_FILE=true
# LOG_PRETTY=true
# LOG_DIR=/absolute/path/to/logs
# LOG_FILE=server.log

# Optional self-signed HTTPS; local loopback is the default.
# HTTPS_SELF_SIGNED=false
# CLIENT_DIST_DIR=/absolute/path/to/client/dist
