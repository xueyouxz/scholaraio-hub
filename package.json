{
  "name": "scholaraio-hub-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.27.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node scripts/dev.mjs --server",
    "dev:client": "node scripts/dev.mjs --client",
    "build": "pnpm --filter @scholaraio-hub/shared build && pnpm --filter @scholaraio-hub/server build && pnpm --filter @scholaraio-hub/client build",
    "clean": "node scripts/clean.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm --filter @scholaraio-hub/shared build && pnpm --filter @scholaraio-hub/server typecheck && pnpm --filter @scholaraio-hub/client typecheck",
    "test": "pnpm --filter @scholaraio-hub/shared test && pnpm --filter @scholaraio-hub/server test && pnpm --filter @scholaraio-hub/client test",
    "test:e2e": "pnpm --filter @scholaraio-hub/client build && playwright test",
    "audit:prod": "pnpm audit --prod",
    "ci:local": "node scripts/ci-local.mjs",
    "prepare": "husky",
    "release:web": "node scripts/release-web.mjs",
    "skills:sync": "node scripts/sync-scholaraio-skills.mjs",
    "setup": "node scripts/hub.mjs setup",
    "start": "node scripts/hub.mjs start",
    "doctor": "node scripts/hub.mjs doctor",
    "migrate": "node scripts/hub.mjs migrate",
    "test:python": "node scripts/test-python.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^4.3.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "tailwindcss": "^4.1.14",
    "typescript": "5.9.3",
    "vite": "^5.4.21"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.9.3",
      "vite": "^5.4.21",
      "vitest": "^2.1.9",
      "zod": "^4.3.6"
    }
  }
}
